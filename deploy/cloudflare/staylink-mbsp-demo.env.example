# Read together with the private demo environment. Keep the rendered directory private.
APP_ORIGIN=https://staylink-mbsp-demo.example.test
CF_DEMO_TUNNEL_ID=
CF_DEMO_ACCESS_TEAM=
CF_DEMO_ACCESS_AUDIENCE=
CF_DEMO_TUNNEL_CREDENTIALS_FILE=/etc/staylink-mbsp-demo/private/tunnel.json
CF_DEMO_ORIGIN_CA_FILE=/etc/staylink-mbsp-demo/tls/origin-ca.pem
CF_DEMO_ORIGIN_CERT_FILE=/etc/staylink-mbsp-demo/tls/loopback.pem
CF_DEMO_ORIGIN_KEY_FILE=/etc/staylink-mbsp-demo/tls/loopback.key
CF_DEMO_WEB_ROOT=/srv/staylink-mbsp-demo/current/apps/web/dist
# Use the same DATABASE_URL and TEST_DATABASE_URL on loopback, with database
# staylink_issue62_cloudflare_test, and the demo flags in deploy/demo/demo.env.example.
