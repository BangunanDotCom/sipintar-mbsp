# Fail-closed template for Linux/Nginx or Windows/IIS. Use a private file outside Git.
NODE_ENV=development
STAYLINK_DEMO_HOST=true
STAYLINK_SYNTHETIC_PORTAL=true
APP_ORIGIN=https://staylink-demo.invalid
API_PORT=3001
# Set the same PostgreSQL URL in both fields. Use 127.0.0.1:5432 and staylink_issue62_<session>_test.
DATABASE_URL=
TEST_DATABASE_URL=
MFA_ENCRYPTION_KEY=
IDENTITY_DATA_KEY=
STAYLINK_DOCUMENT_STORE=disabled
STAYLINK_LOCAL_DOCUMENT_STORE_ENABLED=false
STAYLINK_CLAMAV_ENABLED=false
STAYLINK_DOCUMENT_SCAN_BATCH_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_PRODUCTION_ENABLED=false
# portal.env from the kit supplies officer IDs, district and the mock callback secret.
