# Templat Personal Demo. Kelulusan JTIK diperlukan sebelum pemasangan.
APP_ORIGIN=https://staylink-mbsp-personal.example.test
CF_DEMO_TUNNEL_ID=
CF_DEMO_ACCESS_TEAM=
CF_DEMO_ACCESS_AUDIENCE=
CF_DEMO_TUNNEL_CREDENTIALS_FILE=/etc/staylink-mbsp-personal/private/tunnel.json
CF_DEMO_ORIGIN_CA_FILE=/etc/staylink-mbsp-personal/tls/origin-ca.pem
CF_DEMO_ORIGIN_CERT_FILE=/etc/staylink-mbsp-personal/tls/loopback.pem
CF_DEMO_ORIGIN_KEY_FILE=/etc/staylink-mbsp-personal/tls/loopback.key
CF_DEMO_WEB_ROOT=/srv/staylink-mbsp-personal/current/apps/web/dist
