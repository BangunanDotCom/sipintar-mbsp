generator client {
  provider = "prisma-client-js"
  engineType = "client"
  output = "../node_modules/.prisma/client"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  name String
  email String @unique
  phone String
  identificationHash String? @unique
  identificationEncrypted String?
  identificationMasked String?
  passwordHash String?
  kind String @default("APPLICANT")
  status String @default("ACTIVE")
  emailVerified Boolean @default(false)
  consentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  identities AuthenticationIdentity[]
  sessions Session[]
  factors MfaFactor[]
  recoveryCodes RecoveryCode[]
  roles UserRoleAssignment[]
  representatives CompanyRepresentative[]
  initiatedDrafts ApplicationDraft[]
  notifications Notification[]
  @@map("users")
}
model AuthenticationIdentity {
 id String @id @default(uuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 provider String
 tokenHash String @unique
 expiresAt DateTime
 consumedAt DateTime?
 @@map("authentication_identities")
}
model Session {
 id String @id
 userId String
 user User @relation(fields:[userId],references:[id])
 activeRole String?
 mfaVerified Boolean @default(false)
 csrfHash String
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@map("sessions")
}
model MfaFactor {
 id String @id @default(uuid())
 userId String @unique
 user User @relation(fields:[userId],references:[id])
 encryptedSecret String
 verified Boolean @default(false)
 lastStep BigInt @default(0)
 @@map("mfa_factors")
}
model RecoveryCode {
 id String @id @default(uuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 codeHash String @unique
 usedAt DateTime?
 @@map("recovery_codes")
}
model Role {
 id String @id
 label String
 permissions Permission[]
 assignments UserRoleAssignment[]
 @@map("roles")
}
model Permission {
 id String @id @default(uuid())
 roleId String
 role Role @relation(fields:[roleId],references:[id])
 action String
 @@unique([roleId,action])
 @@map("permissions")
}
model UserRoleAssignment {
 id String @id @default(uuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 roleId String
 role Role @relation(fields:[roleId],references:[id])
 departmentId String?
 districtId String?
 startsAt DateTime @default(now())
 endsAt DateTime?
 status String @default("ACTIVE")
 authorizedBy String?
 reference String
 createdAt DateTime @default(now())
 @@index([userId,roleId])
 @@map("user_role_assignments")
}
model Department {
 id String @id
 name String
 @@map("departments")
}
model District {
 id String @id
 name String
 areas Area[]
 @@map("districts")
}
model Area {
 id String @id @default(uuid())
 name String
 districtId String
 district District @relation(fields:[districtId],references:[id])
 assignments AreaAssignment[]
 @@unique([name,districtId])
 @@map("areas")
}
model AreaAssignment {
 id String @id @default(uuid())
 areaId String
 area Area @relation(fields:[areaId],references:[id])
 userId String
 startsAt DateTime @default(now())
 endsAt DateTime?
 reason String
 assignedBy String
 createdAt DateTime @default(now())
 @@map("area_assignments")
}
model Company {
 id String @id @default(uuid())
 name String
 registrationNumber String @unique
 address String
 phone String
 email String
 status String @default("ACTIVE")
 informationStatus String @default("UNVERIFIED")
 representatives CompanyRepresentative[]
 invitations CompanyRepresentationInvitation[]
 drafts ApplicationDraft[]
 documents DelegationDocument[]
 createdAt DateTime @default(now())
 @@map("companies")
}
model CompanyRepresentative {
 id String @id @default(uuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 companyId String
 company Company @relation(fields:[companyId],references:[id])
 authorityType String
 startsAt DateTime @default(now())
 endsAt DateTime?
 status String @default("UNVERIFIED")
 verifiedBy String?
 verifiedDocumentId String?
 verificationRevision Int @default(0)
 canManageRepresentatives Boolean @default(false)
 @@unique([userId,companyId])
 @@map("company_representatives")
}
model CompanyRepresentationInvitation {
 id String @id @default(uuid())
 companyId String
 company Company @relation(fields:[companyId],references:[id])
 recipientId String
 invitedBy String
 authorityType String
 authorityEndsAt DateTime?
 tokenHash String @unique
 expiresAt DateTime
 acceptedAt DateTime?
 createdAt DateTime @default(now())
 @@index([recipientId])
 @@map("company_representation_invitations")
}
model DelegationDocument {
 id String @id @default(uuid())
 companyId String
 company Company @relation(fields:[companyId],references:[id])
 uploadedBy String
 fileName String
 mimeType String
 content Bytes
 sha256 String
 status String @default("UNVERIFIED")
 validUntil DateTime?
 representativeId String?
 version Int?
 validFrom DateTime?
 byteSize Int?
 authorityType String?
 supersededAt DateTime?
 revokedAt DateTime?
 scanStatus String @default("LEGACY")
 scanLeaseToken String?
 scanLeaseExpiresAt DateTime?
 scanSha256 String?
 scanEngine String?
 scanValidUntil DateTime?
 createdAt DateTime @default(now())
 @@map("delegation_documents")
}
model Notification {
 id String @id @default(uuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 type String
 title String
 message String
 createdAt DateTime @default(now())
 readAt DateTime?
 @@map("notifications")
}
model EmailDeliveryLog {
 id String @id @default(uuid())
 userId String
 recipient String
 type String
 encryptedPayload String
 status String @default("PENDING")
 attempts Int @default(0)
 lastError String?
 createdAt DateTime @default(now())
 sentAt DateTime?
 @@map("email_delivery_logs")
}
model TemplateDefinition {
 id String @id @default(uuid())
 name String
 category String
 versions TemplateVersion[]
 @@map("template_definitions")
}
model TemplateVersion {
 id String @id @default(uuid())
 templateId String
 template TemplateDefinition @relation(fields:[templateId],references:[id])
 version Int
 content String
 status String @default("DRAFT")
 createdBy String
 activatedBy String?
 createdAt DateTime @default(now())
 @@unique([templateId,version])
 @@map("template_versions")
}
model SystemConfiguration {
 key String @id
 value Json
 updatedAt DateTime @updatedAt
 versions ConfigurationVersion[]
 @@map("system_configurations")
}
model ConfigurationVersion {
 id String @id @default(uuid())
 key String
 configuration SystemConfiguration @relation(fields:[key],references:[key])
 value Json
 changedBy String
 reason String
 createdAt DateTime @default(now())
 @@map("configuration_versions")
}
model AuditLog {
 id String @id @default(uuid())
 actorId String?
 activeRole String?
 action String
 target String?
 outcome String @default("SUCCESS")
 metadata Json?
 createdAt DateTime @default(now())
 @@index([createdAt])
 @@map("audit_logs")
}

model ApplicationDraft {
 syntheticSubmissions SyntheticSubmission[]
 documents ApplicationDocument[]
 floors PremiseFloor[]
 premises ApplicationPremises?
 id String @id @default(uuid())
 initiatedByUserId String
 initiatedBy User @relation(fields:[initiatedByUserId],references:[id])
 capacity String
 officialApplicantUserId String?
 companyId String?
 company Company? @relation(fields:[companyId],references:[id])
 initiatorSnapshot Json
 applicantSnapshot Json
 representativeSnapshot Json?
 notes String @default("")
 status String @default("DRAFT")
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([initiatedByUserId,updatedAt])
 @@map("application_drafts")
}

model ApplicationPremises {
 units PremiseUnit[]
 id String @id @default(uuid())
 draftId String @unique
 draft ApplicationDraft @relation(fields:[draftId],references:[id])
 address String?
 postcode String?
 lotNumber String?
 locality String?
 districtId String?
 latitude Float?
 longitude Float?
 locationSource String?
 boundaryStatus String @default("UNVERIFIED")
 buildingType String?
 currentUse String?
 involvedFloors Int?
 accommodationUnits Int?
 totalRooms Int?
 floorAreaSqm Decimal? @db.Decimal(12,2)
 proposedWorkers Int?
 certificateType String?
 certificateNumber String?
 certificateDate DateTime? @db.Date
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([id, draftId], map: "application_premises_id_draft_unique")
 @@map("application_premises")
}

model PremiseFloor {
 documentScopes DraftDocumentScope[]
 unitLinks PremiseUnitFloor[]
 id String @id @default(uuid())
 draftId String
 draft ApplicationDraft @relation(fields:[draftId], references:[id], onDelete: Cascade)
 floorLabel String
 position Int
 rooms Int
 beds Int
 workers Int
 areaSqm Decimal @db.Decimal(12,2)
 facilities Json
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([draftId, floorLabel])
 @@unique([draftId, position])
 @@unique([id, draftId], map: "premise_floors_id_draft_unique")
 @@index([draftId])
 @@map("premise_floors")
}

model PremiseUnit {
 documentScopes DraftDocumentScope[]
 id String @id @default(uuid())
 premiseId String
 draftId String
 premise ApplicationPremises @relation(fields: [premiseId, draftId], references: [id, draftId], onDelete: Restrict, map: "premise_units_premise_draft_fkey")
 unitLabel String
 normalizedLabel String
 floorLinks PremiseUnitFloor[]
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
 @@unique([premiseId, normalizedLabel], map: "premise_units_label_unique")
 @@unique([id, draftId], map: "premise_units_id_draft_unique")
 @@map("premise_units")
}

model PremiseUnitFloor {
 unitId String
 floorId String
 draftId String
 unit PremiseUnit @relation(fields: [unitId, draftId], references: [id, draftId], onDelete: Restrict, map: "premise_unit_floors_unit_draft_fkey")
 floor PremiseFloor @relation(fields: [floorId, draftId], references: [id, draftId], onDelete: Restrict, map: "premise_unit_floors_floor_draft_fkey")
 @@id([unitId, floorId], map: "premise_unit_floors_pkey")
 @@index([floorId, draftId], map: "premise_unit_floors_floor_draft_idx")
 @@map("premise_unit_floors")
}


// Metadata only. Object bytes must remain in private, malware-scanned storage.
model ApplicationDocument {
 scope DraftDocumentScope?
 id String @id @default(uuid())
 draftId String
 draft ApplicationDraft @relation(fields:[draftId], references:[id], onDelete: Cascade)
 category String
 version Int
 fileName String
 mimeType String
 byteSize Int
 sha256 String
 storageKey String @unique
 scanStatus String @default("PENDING")
 scanLeaseToken String?
 scanLeaseExpiresAt DateTime?
 verificationStatus String @default("UNVERIFIED")
 uploadedBy String
 uploadedAt DateTime @default(now())
 verifiedBy String?
 verifiedAt DateTime?
 supersededAt DateTime?
 @@unique([draftId, category, version])
 @@index([draftId, category, uploadedAt])
 @@index([scanStatus, scanLeaseExpiresAt])
 @@unique([id, draftId], map: "application_documents_id_draft_unique")
 @@map("application_documents")
}


model DraftDocumentScope {
 documentId String @id
 draftId String
 unitId String?
 floorId String?
 document ApplicationDocument @relation(fields: [documentId, draftId], references: [id, draftId], onDelete: Cascade, map: "draft_document_scopes_document_fkey")
 unit PremiseUnit? @relation(fields: [unitId, draftId], references: [id, draftId], onDelete: Restrict, map: "draft_document_scopes_unit_fkey")
 floor PremiseFloor? @relation(fields: [floorId, draftId], references: [id, draftId], onDelete: Restrict, map: "draft_document_scopes_floor_fkey")
 @@unique([documentId, draftId], map: "draft_document_scopes_document_unique")
 @@index([unitId, draftId], map: "draft_document_scopes_unit_idx")
 @@index([floorId, draftId], map: "draft_document_scopes_floor_idx")
 @@map("draft_document_scopes")
}

model SyntheticSubmission {
 id String @id @default(uuid())
 draftId String
 draft ApplicationDraft @relation(fields: [draftId], references: [id], onDelete: Restrict, map: "synthetic_submissions_draft_fkey")
 draftVersion Int
 key String
 actorId String
 declarationVersion String
 policyVersion String
 previousId String?
 previous SyntheticSubmission? @relation("SyntheticCorrection", fields: [previousId, draftId], references: [id, draftId], onDelete: Restrict, map: "synthetic_submissions_previous_fkey")
 correction SyntheticSubmission? @relation("SyntheticCorrection")
 snapshot Json
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 @@unique([previousId, draftId], map: "synthetic_submissions_previous_draft_unique")
 @@unique([id, draftId], map: "synthetic_submissions_id_draft_unique")
 @@unique([draftId, key], map: "synthetic_submissions_key_unique")
 @@unique([draftId, draftVersion], map: "synthetic_submissions_version_unique")
 @@map("synthetic_submissions")
}

model TrainingReminderOutbox {
 id String @id @default(uuid())
 draftId String
 draftVersion Int
 recipientId String
 source String
 kind String @default("DRAFT_INACTIVE")
 context Json?
 dedupeKey String @unique(map: "training_reminder_dedupe_key")
 notifiedAt DateTime?
 status String @default("PENDING")
 attempts Int @default(0)
 availableAt DateTime @default(now())
 leaseUntil DateTime?
 lastError String?
 createdAt DateTime @default(now())
 sentAt DateTime?
 @@index([status,availableAt], map: "training_reminder_due_idx")
 @@map("training_reminder_outbox")
}

model SyntheticFinancialEntry {
 id String @id @default(uuid())
 submissionId String
 invoiceId String
 stage Int
 event String
 amountSen Int
 createdAt DateTime @default(now())
 @@unique([submissionId,stage,event])
 @@unique([invoiceId,event])
 @@map("synthetic_financial_entries")
}
