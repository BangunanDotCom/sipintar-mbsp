# Copy outside Git and set permissions appropriate for plaintext lab secrets.
ORACLE_ENV=isolated-synthetic
ORACLE_HOST=127.0.0.1
ORACLE_PORT=15219
ORACLE_SERVICE=FREEPDB1
ORACLE_EXPECTED_DB_NAME=FREEPDB1
# ORACLE_EXPECTED_SERVER_VERSION=23.26.4.0.0
ORACLE_SCHEMA=STL_LAB_OWNER
ORACLE_USER=STL_LAB_OWNER
ORACLE_PASSWORD=
ORACLE_LAB_RUNTIME_USER=STL_LAB_RUNTIME

# Optional grants for the isolated runtime account. Enable only the lab slices in use.
