# Public build-time frontend map settings. Copy to apps/web/.env.local.
# Never put database passwords, identity keys or private credentials in VITE_*.
# Blank primary uses standard HTTPS OpenStreetMap.
VITE_MAP_PRIMARY_URL=
# A custom HTTPS XYZ primary requires licensed attribution as plain text.
VITE_MAP_PRIMARY_ATTRIBUTION=
# Independent OpenFreeMap vector alternative, or none if ICT disables it.
VITE_MAP_FALLBACK=openfreemap
